<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <RootNamespace>NameGuard.ML.Core</RootNamespace>
    <AssemblyName>NameGuard.ML.Core</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>NameGuard.ML.Core</PackageId>
    <Title>NameGuard.ML.Core</Title>
    <Description>Detect whether a name input is a real human name or fake/junk. Hybrid pipeline: heuristic fast-path plus an ML.NET FastTree classifier over character n-grams. Trained model is embedded — no runtime downloads.</Description>
    <PackageTags>name;validation;ml;classification;ml.net;name-guard</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/model.zip" Condition="Exists('Resources/model.zip')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
